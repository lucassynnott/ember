# Optional cloud transcription. Leave blank to keep transcription local.
TRANSCRIPTION_PROVIDER=auto
OPENAI_API_KEY=
GROQ_API_KEY=

# Notes are generated through OpenRouter. Prefer the encrypted Settings field.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Phonon-2 runtime. Defaults to ~/Library/Application Support/MeetingNotes/phonon-venv/bin/fermion.
FERMION_BIN=

# Notion database (data source) ID for saving each call. Settings → Notion overrides this.
NOTION_DATA_SOURCE_ID=

# Local Whisper.cpp fallback installed by `npm run setup:local`.
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL=~/Library/Application Support/MeetingNotes/models/ggml-medium.bin
FFMPEG_BIN=ffmpeg

# This Mac's verified routing.
MICROPHONE_LABEL=Microphone
SYSTEM_AUDIO_LABEL=System Audio
SPEAKER_NAME=Me
MEETING_NOTES_DIR=~/MeetingNotes
